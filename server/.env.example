# Server port (default 3001)
PORT=3001

# Where the SQLite database lives (default: ~/.turbo-downloader)
TURBO_DATA_DIR=

# Default download directory (default: ~/TurboDownloads)
DOWNLOAD_DIR=

# Comma-separated list of allowed CORS origins, or * for any (default *)
CORS_ORIGIN=*

# Optional: path to a yt-dlp binary if it is not on PATH
YT_DLP_PATH=

# Optional: path to an ffmpeg binary if it is not on PATH.
# Required to merge separate video+audio streams (anything above 360p).
FFMPEG_PATH=

# Optional: Netscape-format cookies.txt for yt-dlp. Required to download from
# YouTube on most cloud hosts, which otherwise return
# "Sign in to confirm you're not a bot" / HTTP 403.
YT_DLP_COOKIES=

# Optional: the cookies.txt contents themselves, for hosts with an ephemeral
# filesystem (Render, Fly, Railway) where a file path would not persist.
YT_DLP_COOKIES_DATA=

# Optional: read cookies straight from an installed browser instead of a file,
# e.g. chrome, firefox, edge, brave.
YT_DLP_COOKIES_FROM_BROWSER=

# Optional: absolute path to the built client (client/dist).
# Detected automatically when running from a source checkout.
CLIENT_DIST=
